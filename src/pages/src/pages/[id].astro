---
// src/pages/[id].astro
import Papa from 'papaparse';

// 1. POBIERANIE I PARSOWANIE DANYCH Z TWOJEGO CSV
export async function getStaticPaths() {
  const response = await fetch("https://docs.google.com/spreadsheets/d/e/2PACX-1vRTkrHS1BMQ8RSoUAyoqlBQjmV3eQpBqhaqw_c-2iXXNGv-aUZN_94zrtXJECrwKFBhqYiGgNrCg1lQ/pub?gid=860073749&single=true&output=csv");
  const csvText = await response.text();
  
  // Parsowanie surowego tekstu CSV na tablicę obiektów JavaScript
  const parsedData = Papa.parse(csvText, { header: true });
  
  // Generowanie dynamicznych ścieżek URL (np. /p001, /p002) na podstawie kolumny 'ID'
  return parsedData.data.map((row, index) => ({
    params: { id: row.ID || `p${String(index + 1).padStart(3, '0')}` },
    props: { tool: row },
  }));
}

const { tool } = Astro.props;

// Zabezpieczenie przed pustymi wierszami w bazie danych
if (!tool || !tool.Nazwa_Narzędzia) {
  return Astro.redirect('/404');
}

# Definicje zmiennych do unikalnych tekstów (Dywersyfikacja semantyczna)
const pageTitle = `${tool.Nazwa_Narzędzia} - Recenzja, Opinie i Alternatywy 2026`;
const currentYear = new Date().getFullYear();
---

<html lang="pl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={tool.Meta_Description} />
    
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Product",
      "name": tool.Nazwa_Narzędzia,
      "description": tool.Meta_Description,
      "brand": {
        "@type": "Brand",
        "name": tool.Nazwa_Narzędzia
      },
      "offers": {
        "@type": "Offer",
        "priceCurrency": "USD",
        "price": tool.Cena_Minimalna || "0.00",
        "url": tool.Link_Afiliacyjny
      }
    })} />
</head>
<body class="bg-gray-50 text-gray-900 font-sans antialiased">

    <main class="max-w-4xl mx-auto px-4 py-12">
        <header class="border-b border-gray-200 pb-6 mb-8">
            <span class="text-sm font-semibold text-indigo-600 uppercase tracking-wider">Analiza i Porównanie AI</span>
            <h1 class="text-4xl font-extrabold text-gray-900 mt-2 mb-4">{tool.Nazwa_Narzędzia} ({currentYear})</h1>
            <p class="text-xl text-gray-600 leading-relaxed">{tool.Meta_Description}</p>
        </header>

        <section class="mb-12">
            <h2 class="text-2xl font-bold mb-4">Specyfikacja Techniczna Narzędzia</h2>
            <div class="overflow-x-auto bg-white shadow rounded-lg">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Parametr</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Szczegóły</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200 text-sm">
                        <tr>
                            <td class="px-6 py-4 font-medium text-gray-900">Model Rozliczeniowy</td>
                            <td class="px-6 py-4 text-gray-500">{tool.Model_Biznesowy || 'SaaS / Freemium'}</td>
                        </tr>
                        <tr>
                            <td class="px-6 py-4 font-medium text-gray-900">Główne Zastosowanie</td>
                            <td class="px-6 py-4 text-gray-500">{tool.Kategoria || 'Generowanie Wideo AI'}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <section class="prose lg:prose-lg max-w-none text-gray-700 leading-8 mb-12">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Szczegółowa recenzja i możliwości {tool.Nazwa_Narzędzia}</h2>
            <p>
                W dzisiejszych realiach rynkowych {tool.Nazwa_Narzędzia} staje się jednym z kluczowych rozwiązań w kategorii systemów automatyzacji wideo. Implementacja tego oprogramowania pozwala na znaczące skrócenie czasu potrzebnego na renderowanie i przygotowanie gotowych materiałów wideo dla algorytmów takich platform jak TikTok czy YouTube Shorts.
            </p>
            <p>
                Analizując parametry techniczne tego produktu, warto zwrócić uwagę na unikalną architekturę przetwarzania danych. Dzięki zastosowaniu zaawansowanych modeli generatywnych, użytkownicy końcowi mogą cieszyć się wysoką powtarzalnością wyników przy minimalnym nakładzie pracy manualnej. Odpowiada to bezpośrednio na zapotrzebowanie nowoczesnych solo-operatorów biznesowych, szukających optymalizacji kosztów infrastruktury.
            </p>
        </section>

        <div class="bg-indigo-50 rounded-2xl p-8 border border-indigo-100 text-center mb-12">
            <h3 class="text-xl font-bold text-indigo-900 mb-2">Chcesz przetestować to narzędzie w praktyce?</h3>
            <p class="text-indigo-700 mb-6">Uruchom darmowe konto testowe i sprawdź pełnię możliwości generowania wideo.</p>
            <a href={tool.Link_Afiliacyjny} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm transition-colors">
                Wypróbuj {tool.Nazwa_Narzędzia} za darmo &rarr;
            </a>
        </div>
    </main>

</body>
</html>
